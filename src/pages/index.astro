---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="fortuneP">
  <main class="relative flex min-h-screen flex-col items-center justify-between overflow-hidden bg-fp-navy px-6 py-10 select-none">

    <!-- ========== 背景レイヤー ========== -->

    <!-- 深いグラデーション -->
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#06081a] via-fp-navy to-[#140d35]"></div>

    <!-- ボケ玉 (大) -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="bokeh-orb" style="width:90px;height:90px;top:1%;left:8%;opacity:0.85;animation-delay:0s"></div>
      <div class="bokeh-orb" style="width:55px;height:55px;top:3%;left:28%;opacity:0.6;animation-delay:0.8s"></div>
      <div class="bokeh-orb" style="width:70px;height:70px;top:0%;left:52%;opacity:0.75;animation-delay:1.4s"></div>
      <div class="bokeh-orb" style="width:40px;height:40px;top:5%;left:68%;opacity:0.55;animation-delay:0.3s"></div>
      <div class="bokeh-orb" style="width:80px;height:80px;top:2%;right:6%;opacity:0.8;animation-delay:1s"></div>
      <div class="bokeh-orb" style="width:30px;height:30px;top:8%;left:42%;opacity:0.45;animation-delay:2s"></div>
      <div class="bokeh-orb" style="width:50px;height:50px;top:6%;left:15%;opacity:0.5;animation-delay:1.7s"></div>
      <div class="bokeh-orb" style="width:35px;height:35px;top:4%;right:22%;opacity:0.6;animation-delay:0.5s"></div>
    </div>

    <!-- 小さいキラ星 -->
    <div class="pointer-events-none absolute inset-0">
      <span class="sparkle" style="top:12%;left:18%">✦</span>
      <span class="sparkle" style="top:18%;left:72%;animation-delay:1s">✦</span>
      <span class="sparkle" style="top:9%;left:45%;animation-delay:1.8s">✦</span>
      <span class="sparkle" style="top:22%;right:12%;animation-delay:0.5s">✦</span>
      <span class="sparkle" style="top:15%;left:5%;animation-delay:2.2s">✦</span>
      <span class="sparkle" style="top:7%;right:38%;animation-delay:1.3s">✦</span>
    </div>

    <!-- ========== ヘッダー ========== -->
    <div class="relative z-10 text-center">
      <h1 class="font-cinzel text-4xl font-semibold tracking-[0.15em] text-fp-gold"
          style="text-shadow: 0 0 30px rgba(201,168,76,0.5), 0 0 60px rgba(201,168,76,0.2)">
        fortuneP
      </h1>
      <div class="mt-2 flex items-center justify-center gap-3">
        <span class="h-px w-10 bg-fp-gold/40"></span>
        <p class="text-[11px] tracking-[0.3em] text-fp-gold/60 uppercase">Astrology Reading</p>
        <span class="h-px w-10 bg-fp-gold/40"></span>
      </div>
    </div>

    <!-- ========== 中央の星座ホイール ========== -->
    <div class="relative z-10 flex items-center justify-center">
      <div class="zodiac-wheel">
        <!-- 外周リング -->
        <div class="zodiac-ring outer"></div>
        <div class="zodiac-ring inner"></div>

        <!-- 12星座のドット -->
        {Array.from({length: 12}, (_, i) => (
          <div
            class="zodiac-dot"
            style={`transform: rotate(${i * 30}deg) translateY(-96px) rotate(-${i * 30}deg)`}
          ></div>
        ))}

        <!-- 中央シンボル -->
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-1">
          <span class="text-5xl text-fp-gold/70"
                style="text-shadow: 0 0 20px rgba(201,168,76,0.4)">✦</span>
          <p class="text-[9px] tracking-[0.4em] text-fp-pearl/30 uppercase">Horoscope</p>
        </div>
      </div>
    </div>

    <!-- ========== コピー ========== -->
    <div class="relative z-10 text-center space-y-2">
      <p class="text-base font-light leading-loose text-fp-pearl/80">
        表の自分と、心の奥を<br />星から読む。
      </p>
      <p class="text-xs text-fp-pearl/30">太陽 · 月 · アセンダント</p>
    </div>

    <!-- ========== 軌道ボタン ========== -->
    <div class="relative z-10 flex flex-col items-center gap-8">
      <a href={`${import.meta.env.BASE_URL}input`} class="orbital-btn" aria-label="星を読む">
        <!-- 軌道リング 1 -->
        <div class="orb-ring" style="width:130px;height:130px;animation-duration:6s">
          <div class="orb-dot" style="width:7px;height:7px"></div>
        </div>
        <!-- 軌道リング 2 -->
        <div class="orb-ring" style="width:160px;height:160px;animation-duration:9s;animation-direction:reverse">
          <div class="orb-dot" style="width:5px;height:5px;top:-2.5px"></div>
          <div class="orb-dot" style="width:4px;height:4px;top:auto;bottom:-2px;left:calc(50% - 2px);opacity:0.5"></div>
        </div>
        <!-- 軌道リング 3 -->
        <div class="orb-ring" style="width:195px;height:195px;animation-duration:14s;opacity:0.5">
          <div class="orb-dot" style="width:4px;height:4px;opacity:0.6"></div>
        </div>
        <!-- 中心ボタン -->
        <div class="orb-center">
          <span class="font-sans text-sm font-medium text-fp-dark">星を読む</span>
        </div>
      </a>

      <p class="text-[10px] text-fp-pearl/25 tracking-widest">TAP TO BEGIN</p>
    </div>

  </main>
</Layout>

<style>
  /* Cinzel フォント */
  .font-cinzel { font-family: 'Cinzel', serif; }

  /* ボケ玉 */
  .bokeh-orb {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, rgba(230,190,60,1) 0%, rgba(201,168,76,0.4) 40%, transparent 70%);
    filter: blur(10px);
    animation: bokeh-float 4s ease-in-out infinite;
  }
  @keyframes bokeh-float {
    0%, 100% { transform: translateY(0) scale(1); opacity: var(--op, 0.7); }
    50%       { transform: translateY(-6px) scale(1.05); opacity: calc(var(--op, 0.7) * 0.8); }
  }

  /* キラ星 */
  .sparkle {
    position: absolute;
    font-size: 10px;
    color: rgba(255,255,255,0.7);
    animation: sparkle-blink 2.5s ease-in-out infinite;
  }
  @keyframes sparkle-blink {
    0%, 100% { opacity: 0.8; transform: scale(1); }
    50%       { opacity: 0.2; transform: scale(0.7); }
  }

  /* 星座ホイール */
  .zodiac-wheel {
    position: relative;
    width: 220px;
    height: 220px;
  }
  .zodiac-ring {
    position: absolute;
    top: 50%; left: 50%;
    border-radius: 50%;
    border: 1px solid rgba(201,168,76,0.2);
    transform: translate(-50%, -50%);
  }
  .zodiac-ring.outer { width: 210px; height: 210px; }
  .zodiac-ring.inner { width: 170px; height: 170px; border-color: rgba(201,168,76,0.1); }

  .zodiac-dot {
    position: absolute;
    top: 50%; left: 50%;
    width: 5px; height: 5px;
    margin: -2.5px;
    border-radius: 50%;
    background: rgba(201,168,76,0.6);
    box-shadow: 0 0 6px rgba(201,168,76,0.4);
  }

  /* 軌道ボタン */
  .orbital-btn {
    position: relative;
    width: 195px; height: 195px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .orb-ring {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) rotate(0deg);
    border-radius: 50%;
    border: 1px solid rgba(201,168,76,0.25);
    animation: ring-spin linear infinite;
  }
  .orb-dot {
    position: absolute;
    top: -3.5px;
    left: calc(50% - 3.5px);
    border-radius: 50%;
    background: rgba(201,168,76,0.95);
    box-shadow: 0 0 8px rgba(201,168,76,0.6);
  }
  @keyframes ring-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .orb-center {
    position: absolute;
    width: 90px; height: 90px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #f5de7a, #c9a84c 55%, #a07830 100%);
    box-shadow: 0 0 30px rgba(201,168,76,0.5), 0 0 60px rgba(201,168,76,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .orbital-btn:active .orb-center {
    transform: scale(0.94);
    box-shadow: 0 0 18px rgba(201,168,76,0.4);
  }
</style>
