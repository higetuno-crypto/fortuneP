---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

// ビルド時に全コンテンツを読み込み、クライアントに渡す
const sunEntries = await getCollection("sun-signs");
const moonEntries = await getCollection("moon-signs");
const ascEntries = await getCollection("ascendants");

type SignData = { label: string; body: string };

const sunData: Record<string, SignData> = Object.fromEntries(
  sunEntries.map((e) => [e.id, { label: e.data.label, body: e.body }])
);
const moonData: Record<string, SignData> = Object.fromEntries(
  moonEntries.map((e) => [e.id, { label: e.data.label, body: e.body }])
);
const ascData: Record<string, SignData> = Object.fromEntries(
  ascEntries.map((e) => [e.id, { label: e.data.label, body: e.body }])
);

function rnd(a: number, b: number) { return a + Math.random() * (b - a); }
const microStars = Array.from({ length: 110 }, () => ({
  x: rnd(0, 100), y: rnd(0, 100),
  s: Math.random() < 0.6 ? 0.8 : 1,
  op: rnd(0.12, 0.45), dur: rnd(3, 8), del: rnd(0, 7),
  color: Math.random() < 0.3 ? '#d0e4ff' : '#ffffff',
}));
const smallStars = Array.from({ length: 40 }, () => ({
  x: rnd(0, 100), y: rnd(0, 100),
  s: rnd(1.2, 2), op: rnd(0.35, 0.7), dur: rnd(2, 5), del: rnd(0, 5),
  color: Math.random() < 0.35 ? '#c8dcff' : '#ffffff',
}));
const brightStars = Array.from({ length: 5 }, () => ({
  x: rnd(5, 95), y: rnd(5, 90),
  s: rnd(2.3, 3), op: rnd(0.65, 1), dur: rnd(2, 4), del: rnd(0, 4),
}));
const spikeStars = [{ x: rnd(70, 90), y: rnd(5, 20) }];
---

<Layout title="あなたの星読み">
<main class="fp-result-main">

  <!-- 背景 -->
  <div class="bg-space"></div>

  <!-- 星空 -->
  <div class="layer-stars" aria-hidden="true">
    {microStars.map(s => (
      <div class="star-micro" style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;opacity:${s.op};animation-duration:${s.dur}s;animation-delay:${s.del}s;background:${s.color}`}></div>
    ))}
    {smallStars.map(s => (
      <div class="star-small" style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;opacity:${s.op};animation-duration:${s.dur}s;animation-delay:${s.del}s;background:${s.color}`}></div>
    ))}
    {brightStars.map(s => (
      <div class="star-bright" style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;opacity:${s.op};animation-duration:${s.dur}s;animation-delay:${s.del}s`}></div>
    ))}
    {spikeStars.map(s => (
      <div class="star-spike" style={`left:${s.x}%;top:${s.y}%`}></div>
    ))}
  </div>

  <!-- ボケ玉 (控えめ) -->
  <div class="layer-bokeh" aria-hidden="true">
    <div class="bokeh" style="width:55px;height:55px;top:0%;left:5%;animation-delay:0s;opacity:0.6"></div>
    <div class="bokeh" style="width:40px;height:40px;top:1%;right:8%;animation-delay:1.5s;opacity:0.5"></div>
  </div>

  <!-- ========== コンテンツ ========== -->
  <div class="result-scroll">

    <!-- ローディング中 -->
    <div id="state-loading" class="state-center">
      <span class="text-3xl text-fp-gold" style="animation: star-pulse 2s ease-in-out infinite">✦</span>
      <p class="text-sm text-fp-pearl/40 mt-3">読み込んでいます</p>
    </div>

    <!-- エラー -->
    <div id="state-error" class="hidden state-center">
      <p class="text-fp-pearl/60 mb-6">生年月日が見つかりませんでした</p>
      <a href={`${import.meta.env.BASE_URL}/input`} class="btn-gold text-sm">もう一度入力する</a>
    </div>

    <!-- 結果 -->
    <div id="state-result" class="hidden result-content">

      <!-- ヘッダー -->
      <div class="result-header fade-in">
        <p class="result-eyebrow">✦ Your Reading ✦</p>
        <p id="result-date" class="result-date"></p>
      </div>

      <!-- 3要素バッジ -->
      <div id="result-badges" class="badges-card glass-card fade-in fade-in-delay-1">
        <p class="badges-title">あなたの3つの星</p>
        <div class="badges-grid">
          <div class="badge-item">
            <p class="badge-symbol badge-sun" id="badge-sun-symbol"></p>
            <p class="badge-type">太陽</p>
            <p class="badge-label" id="badge-sun-label"></p>
          </div>
          <div class="badge-item">
            <p class="badge-symbol badge-moon" id="badge-moon-symbol"></p>
            <p class="badge-type">月</p>
            <p class="badge-label" id="badge-moon-label"></p>
          </div>
          <div class="badge-item">
            <p class="badge-symbol badge-asc" id="badge-asc-symbol"></p>
            <p class="badge-type">ASC</p>
            <p class="badge-label" id="badge-asc-label"></p>
          </div>
        </div>
      </div>

      <!-- 太陽星座 -->
      <section class="reading-card glass-card fade-in fade-in-delay-2">
        <div class="reading-header">
          <span class="reading-icon sun-icon">☀</span>
          <div>
            <p class="reading-type">Sun Sign · 表の核</p>
            <h2 class="reading-sign-label" id="sun-label"></h2>
          </div>
        </div>
        <div id="sun-body" class="reading-body"></div>
      </section>

      <!-- 月星座 -->
      <section id="section-moon" class="reading-card glass-card fade-in fade-in-delay-3">
        <div class="reading-header">
          <span class="reading-icon moon-icon">☽</span>
          <div>
            <p class="reading-type moon-type">Moon Sign · 心の奥</p>
            <h2 class="reading-sign-label" id="moon-label"></h2>
          </div>
        </div>
        <div id="moon-body" class="reading-body"></div>
        <p id="moon-note" class="hidden reading-note">
          ※ 出生時間が分かるとより正確に読めます
        </p>
      </section>

      <!-- アセンダント -->
      <section id="section-asc" class="reading-card glass-card fade-in fade-in-delay-4">
        <div class="reading-header">
          <span class="reading-icon asc-icon">↑</span>
          <div>
            <p class="reading-type asc-type">Ascendant · 外側の入口</p>
            <h2 class="reading-sign-label" id="asc-label"></h2>
          </div>
        </div>
        <div id="asc-body" class="reading-body"></div>
      </section>

      <!-- ASC なし -->
      <div id="section-asc-missing" class="hidden glass-card asc-missing-card fade-in fade-in-delay-4">
        <span class="asc-missing-icon">↑</span>
        <p class="asc-missing-title">アセンダント · 外側の入口</p>
        <p class="asc-missing-body">出生時間が分かると、<br />アセンダントも読めます</p>
        <a href={`${import.meta.env.BASE_URL}/input`} class="asc-missing-link">もう一度入力する</a>
      </div>

      <!-- フッター -->
      <div class="result-footer fade-in fade-in-delay-4">
        <!-- 小さな魔法陣 -->
        <div class="footer-magic" aria-hidden="true">
          <div class="fm-ring outer"></div>
          <div class="fm-ring inner"></div>
          <div class="fm-center">✦</div>
        </div>

        <a href={`${import.meta.env.BASE_URL}/input`} class="footer-back-link">
          ← 別の生年月日で読む
        </a>
        <a href={import.meta.env.BASE_URL} class="footer-home-link">
          fortuneP
        </a>
      </div>
    </div>

  </div><!-- /result-scroll -->
</main>
</Layout>

<!-- ビルド時のコンテンツデータをグローバルに注入 -->
<script define:vars={{ sunData, moonData, ascData }}>
  window.__fp_sun = sunData;
  window.__fp_moon = moonData;
  window.__fp_asc = ascData;
</script>

<script>
  import { getSunSign, getMoonSign, getAscendant, toJaLabel, toSymbol } from "../lib/index";

  // 主要都市の緯度経度
  const CITY_COORDS: Record<string, [number, number]> = {
    東京: [35.6895, 139.6917],
    大阪: [34.6937, 135.5023],
    京都: [35.0116, 135.7681],
    名古屋: [35.1815, 136.9066],
    札幌: [43.0642, 141.3469],
    福岡: [33.5904, 130.4017],
    仙台: [38.2688, 140.8721],
    広島: [34.3963, 132.4596],
    神戸: [34.6901, 135.1955],
    横浜: [35.4437, 139.6380],
    那覇: [26.2124, 127.6809],
    金沢: [36.5944, 136.6256],
    新潟: [37.9162, 139.0364],
    熊本: [32.8031, 130.7079],
    長崎: [32.7448, 129.8737],
  };

  function resolveCoords(birthplace: string): [number, number] {
    for (const [city, coords] of Object.entries(CITY_COORDS)) {
      if (birthplace.includes(city)) return coords;
    }
    return [35.6895, 139.6917]; // デフォルト: 東京
  }

  function show(id: string) {
    document.getElementById(id)!.classList.remove("hidden");
  }
  function hide(id: string) {
    document.getElementById(id)!.classList.add("hidden");
  }
  function setText(id: string, text: string) {
    document.getElementById(id)!.textContent = text;
  }

  async function render() {
    const params = new URLSearchParams(window.location.search);
    const year  = parseInt(params.get("year")  ?? "");
    const month = parseInt(params.get("month") ?? "");
    const day   = parseInt(params.get("day")   ?? "");

    if (!year || !month || !day || isNaN(year) || isNaN(month) || isNaN(day)) {
      hide("state-loading");
      show("state-error");
      return;
    }

    const hourRaw    = params.get("hour");
    const minuteRaw  = params.get("minute");
    const birthplace = params.get("birthplace") ?? "";

    const hasTime = hourRaw !== "" && hourRaw !== null;
    const hour    = hasTime ? parseInt(hourRaw!) : 12;
    const minute  = minuteRaw ? parseInt(minuteRaw) : 0;

    // 計算
    const sunSign  = getSunSign(month, day);
    const moonSign = getMoonSign(year, month, day, hour, minute);

    let ascSign = undefined;
    if (hasTime) {
      const [lat, lon] = resolveCoords(birthplace);
      ascSign = getAscendant(year, month, day, hour, minute, lat, lon);
    }

    // コンテンツ
    const sun  = (window as any).__fp_sun[sunSign];
    const moon = (window as any).__fp_moon[moonSign];
    const asc  = ascSign ? (window as any).__fp_asc[ascSign] : null;

    // --- 描画 ---
    hide("state-loading");
    show("state-result");

    // 日付
    setText("result-date", `${year}年${month}月${day}日生まれ`);

    // バッジ
    setText("badge-sun-symbol",  toSymbol(sunSign));
    setText("badge-sun-label",   toJaLabel(sunSign));
    setText("badge-moon-symbol", toSymbol(moonSign));
    setText("badge-moon-label",  toJaLabel(moonSign));
    if (ascSign) {
      setText("badge-asc-symbol", toSymbol(ascSign));
      setText("badge-asc-label",  toJaLabel(ascSign));
    } else {
      setText("badge-asc-symbol", "—");
      setText("badge-asc-label",  "未算出");
    }

    // 太陽
    setText("sun-label", sun.label);
    setText("sun-body",  sun.body.trim());

    // 月
    setText("moon-label", moon.label);
    setText("moon-body",  moon.body.trim());
    if (!hasTime) {
      show("moon-note");
    }

    // アセンダント
    if (asc && ascSign) {
      setText("asc-label", asc.label);
      setText("asc-body",  asc.body.trim());
      show("section-asc");
    } else {
      show("section-asc-missing");
    }
  }

  render();
</script>

<style>
.fp-result-main {
  position: relative;
  min-height: 100svh;
  overflow-x: hidden;
}

.bg-space {
  position: fixed; inset: 0;
  background:
    radial-gradient(ellipse 30% 20% at 72% 14%, rgba(175,50,150,0.11) 0%, transparent 100%),
    radial-gradient(ellipse 55% 65% at 38% 60%, rgba(85,58,22,0.09) 0%, transparent 100%),
    radial-gradient(ellipse 130% 100% at 50% 45%, rgba(16,32,82,0.55) 0%, rgba(3,7,20,0.92) 60%, #010509 100%),
    radial-gradient(ellipse 80% 25% at 50% 108%, rgba(28,58,138,0.28) 0%, transparent 100%),
    #010509;
  z-index: 0;
}

.layer-stars, .layer-bokeh {
  position: fixed; inset: 0;
  pointer-events: none;
}
.layer-stars {
  z-index: 1;
  animation: star-drift 90s ease-in-out infinite;
  transform-origin: 50% 50%;
}
.layer-bokeh { z-index: 2; }

@keyframes star-drift {
  0%,100% { transform: scale(1.000); }
  50%     { transform: scale(1.018); }
}

.star-micro {
  position: absolute; border-radius: 50%;
  animation: twinkle-slow ease-in-out infinite;
}
.star-small {
  position: absolute; border-radius: 50%;
  animation: twinkle ease-in-out infinite;
}
.star-bright {
  position: absolute; border-radius: 50%;
  background: #ffffff;
  box-shadow:
    0 0 2px 1px rgba(255,255,255,0.95),
    0 0 6px 2px rgba(200,220,255,0.6),
    0 0 14px 5px rgba(160,190,255,0.25),
    0 0 28px 8px rgba(120,160,255,0.1);
  animation: twinkle-bright ease-in-out infinite;
}
.star-spike {
  position: absolute;
  width: 4px; height: 4px; margin: -2px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow:
    0 0 3px 2px rgba(255,255,255,1),
    0 0 8px 4px rgba(200,225,255,0.7),
    0 0 20px 8px rgba(160,195,255,0.35),
    0 0 40px 14px rgba(120,165,255,0.12);
  animation: spike-pulse 3s ease-in-out infinite;
}
.star-spike::before {
  content: '';
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  width: 55px; height: 1px;
  background: linear-gradient(to right, transparent, rgba(200,225,255,0.35) 30%, rgba(255,255,255,0.7) 50%, rgba(200,225,255,0.35) 70%, transparent);
}
.star-spike::after {
  content: '';
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%) rotate(90deg);
  width: 55px; height: 1px;
  background: linear-gradient(to right, transparent, rgba(200,225,255,0.35) 30%, rgba(255,255,255,0.7) 50%, rgba(200,225,255,0.35) 70%, transparent);
}

@keyframes twinkle-slow   { 0%,100%{opacity:inherit;transform:scale(1)} 50%{opacity:0.05;transform:scale(0.5)} }
@keyframes twinkle        { 0%,100%{opacity:inherit;transform:scale(1)} 50%{opacity:0.1;transform:scale(0.6)} }
@keyframes twinkle-bright { 0%,100%{opacity:inherit;transform:scale(1)} 40%{opacity:0.2;transform:scale(0.7)} 60%{opacity:0.2;transform:scale(0.7)} }
@keyframes spike-pulse    { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.55;transform:scale(0.85)} }

.bokeh {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, rgba(240,210,60,1) 0%, rgba(201,168,76,0.35) 45%, transparent 70%);
  filter: blur(10px);
  animation: bk-float 4.5s ease-in-out infinite;
}
@keyframes bk-float {
  0%,100% { transform: translateY(0) scale(1); }
  50%      { transform: translateY(-8px) scale(1.06); }
}


/* スクロール領域 */
.result-scroll {
  position: relative; z-index: 10;
  padding: 3rem 1.25rem 4rem;
}

.state-center {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  min-height: 80svh;
  text-align: center;
}

/* 結果コンテンツ */
.result-content {
  max-width: 480px;
  margin: 0 auto;
  display: flex; flex-direction: column;
  gap: 1.5rem;
}

/* ヘッダー */
.result-header { text-align: center; }
.result-eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.35em;
  color: rgba(201,168,76,0.55);
  margin-bottom: 0.5rem;
}
.result-date {
  font-size: 0.75rem;
  color: rgba(232,224,208,0.35);
}

/* バッジカード */
.badges-card {
  padding: 1.25rem 1rem;
}
.badges-title {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  color: rgba(232,224,208,0.35);
  text-align: center;
  text-transform: uppercase;
  margin-bottom: 1rem;
}
.badges-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
  text-align: center;
}
.badge-item {}
.badge-symbol { font-size: 1.4rem; }
.badge-sun { color: rgba(201,168,76,0.9); }
.badge-moon { color: rgba(139,167,217,0.9); }
.badge-asc { color: rgba(232,224,208,0.55); }
.badge-type { font-size: 0.6rem; color: rgba(232,224,208,0.4); margin-top: 0.15rem; }
.badge-label { font-size: 0.7rem; color: rgba(232,224,208,0.85); margin-top: 0.25rem; }

/* リーディングカード */
.reading-card {
  padding: 1.5rem 1.25rem;
  display: flex; flex-direction: column; gap: 1rem;
}
.reading-header {
  display: flex; align-items: flex-start; gap: 0.75rem;
}
.reading-icon { font-size: 1.5rem; }
.sun-icon { color: rgba(201,168,76,0.9); }
.moon-icon { color: rgba(139,167,217,0.85); }
.asc-icon { color: rgba(232,224,208,0.5); }
.reading-type {
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(201,168,76,0.55);
}
.moon-type { color: rgba(139,167,217,0.55); }
.asc-type { color: rgba(232,224,208,0.35); }
.reading-sign-label {
  font-family: 'Noto Serif JP', serif;
  font-size: 1.15rem; font-weight: 300;
  color: rgba(232,224,208,0.95);
  margin-top: 0.25rem;
}
.reading-body {
  font-size: 0.85rem;
  line-height: 1.95;
  color: rgba(232,224,208,0.75);
  white-space: pre-wrap;
}
.reading-note {
  font-size: 0.68rem;
  color: rgba(139,167,217,0.5);
  border-top: 1px solid rgba(255,255,255,0.05);
  padding-top: 0.75rem;
}

/* ASC なし */
.asc-missing-card {
  padding: 1.5rem 1.25rem;
  text-align: center;
  display: flex; flex-direction: column;
  align-items: center; gap: 0.5rem;
}
.asc-missing-icon { font-size: 1.25rem; color: rgba(232,224,208,0.25); }
.asc-missing-title { font-size: 0.85rem; color: rgba(232,224,208,0.45); }
.asc-missing-body {
  font-size: 0.75rem;
  color: rgba(232,224,208,0.3);
  line-height: 1.8;
}
.asc-missing-link {
  font-size: 0.7rem;
  color: rgba(139,167,217,0.55);
  text-decoration: underline;
  text-underline-offset: 4px;
  margin-top: 0.5rem;
}

/* フッター */
.result-footer {
  padding-top: 1rem;
  padding-bottom: 2rem;
  display: flex; flex-direction: column;
  align-items: center; gap: 1.25rem;
  text-align: center;
}

/* 小魔法陣 */
.footer-magic {
  position: relative;
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
}
.fm-ring {
  position: absolute; top: 50%; left: 50%;
  border-radius: 50%;
  transform: translate(-50%,-50%);
}
.fm-ring.outer {
  width: 44px; height: 44px;
  border: 1px solid rgba(201,168,76,0.2);
  animation: ring-spin 10s linear infinite;
}
.fm-ring.inner {
  width: 30px; height: 30px;
  border: 1px solid rgba(201,168,76,0.12);
  animation: ring-spin 7s linear infinite reverse;
}
.fm-center {
  position: absolute;
  font-size: 0.8rem;
  color: rgba(201,168,76,0.45);
  text-shadow: 0 0 8px rgba(201,168,76,0.4);
  animation: star-pulse 2.5s ease-in-out infinite;
}

@keyframes ring-spin {
  from { transform: translate(-50%,-50%) rotate(0deg); }
  to   { transform: translate(-50%,-50%) rotate(360deg); }
}
@keyframes star-pulse {
  0%,100% { opacity: 0.45; }
  50%      { opacity: 0.9; }
}

.footer-back-link {
  font-size: 0.75rem;
  color: rgba(232,224,208,0.35);
  transition: color 0.2s;
}
.footer-back-link:hover { color: rgba(232,224,208,0.7); }

.footer-home-link {
  font-family: 'Cinzel', serif;
  font-size: 0.8rem;
  color: rgba(201,168,76,0.35);
  letter-spacing: 0.1em;
  transition: color 0.2s;
}
.footer-home-link:hover { color: rgba(201,168,76,0.7); }
</style>
