---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

function rnd(a: number, b: number) { return a + Math.random() * (b - a); }

const microStars = Array.from({ length: 140 }, () => ({
  x: rnd(0, 100), y: rnd(0, 100),
  s: Math.random() < 0.6 ? 0.8 : 1,
  op: rnd(0.15, 0.5), dur: rnd(3, 8), del: rnd(0, 7),
  color: Math.random() < 0.3 ? '#d0e4ff' : '#ffffff',
}));
const smallStars = Array.from({ length: 55 }, () => ({
  x: rnd(0, 100), y: rnd(0, 100),
  s: rnd(1.2, 2), op: rnd(0.4, 0.8), dur: rnd(2, 5), del: rnd(0, 5),
  color: Math.random() < 0.35 ? '#c8dcff' : '#ffffff',
}));
const brightStars = Array.from({ length: 7 }, () => ({
  x: rnd(5, 95), y: rnd(5, 90),
  s: rnd(2.5, 3.2), op: rnd(0.7, 1), dur: rnd(2, 4), del: rnd(0, 4),
}));
const spikeStars = [
  { x: rnd(20, 40), y: rnd(10, 25) },
  { x: rnd(65, 85), y: rnd(65, 85) },
];

const blazingY = rnd(12, 32);
---

<Layout title="星を読んでいます">
<main class="fp-loading-main">

  <!-- 背景 -->
  <div class="bg-space"></div>

  <!-- 星空 -->
  <div class="layer-stars" aria-hidden="true">
    {microStars.map(s => (
      <div class="star-micro" style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;opacity:${s.op};animation-duration:${s.dur}s;animation-delay:${s.del}s;background:${s.color}`}></div>
    ))}
    {smallStars.map(s => (
      <div class="star-small" style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;opacity:${s.op};animation-duration:${s.dur}s;animation-delay:${s.del}s;background:${s.color}`}></div>
    ))}
    {brightStars.map(s => (
      <div class="star-bright" style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;opacity:${s.op};animation-duration:${s.dur}s;animation-delay:${s.del}s`}></div>
    ))}
    {spikeStars.map(s => (
      <div class="star-spike" style={`left:${s.x}%;top:${s.y}%`}></div>
    ))}
  </div>

  <!-- ブレイジングスター -->
  <div class="layer-shooting" aria-hidden="true">
    <div class="blazing-star" style={`top:${blazingY.toFixed(1)}%`}>
      <div class="blazing-head"></div>
      <div class="trail-orb large"  style="left:22px;top:calc(50% + 2px)"></div>
      <div class="trail-orb large"  style="left:38px;top:calc(50% - 4px)"></div>
      <div class="trail-orb large"  style="left:55px;top:calc(50% + 5px)"></div>
      <div class="trail-orb mid"    style="left:76px;top:calc(50% - 3px)"></div>
      <div class="trail-orb mid"    style="left:99px;top:calc(50% + 7px)"></div>
      <div class="trail-orb mid"    style="left:124px;top:calc(50% - 5px)"></div>
      <div class="trail-orb small"  style="left:155px;top:calc(50% + 9px)"></div>
      <div class="trail-orb small"  style="left:190px;top:calc(50% - 7px)"></div>
      <div class="trail-orb small"  style="left:228px;top:calc(50% + 4px)"></div>
    </div>
  </div>

  <!-- ボケ玉 -->
  <div class="layer-bokeh" aria-hidden="true">
    <div class="bokeh" style="width:60px;height:60px;top:2%;left:10%;animation-delay:0s"></div>
    <div class="bokeh" style="width:40px;height:40px;top:1%;right:15%;animation-delay:1.2s"></div>
    <div class="bokeh" style="width:50px;height:50px;bottom:8%;left:20%;animation-delay:0.7s"></div>
    <div class="bokeh" style="width:35px;height:35px;bottom:5%;right:10%;animation-delay:1.9s"></div>
  </div>

  <!-- メインコンテンツ -->
  <div class="loading-content">
    <!-- 魔法陣ローディングリング -->
    <div class="magic-loader">
      <!-- 外周 -->
      <div class="ml-ring" style="width:160px;height:160px;animation-duration:12s;border-color:rgba(201,168,76,0.15)">
        <!-- 12星座の点 -->
        {Array.from({ length: 12 }, (_, i) => (
          <div class="ml-dot" style={`transform:rotate(${i*30}deg) translateY(-79px) rotate(-${i*30}deg)`}></div>
        ))}
      </div>
      <!-- 中間リング -->
      <div class="ml-ring" style="width:120px;height:120px;animation-duration:7s;animation-direction:reverse;border-color:rgba(139,167,217,0.2)">
        <div class="ml-orb-dot" style="background:rgba(139,167,217,0.9);box-shadow:0 0 6px rgba(139,167,217,0.7)"></div>
      </div>
      <!-- 内側リング -->
      <div class="ml-ring" style="width:82px;height:82px;animation-duration:4.5s;border-color:rgba(201,168,76,0.25)">
        <div class="ml-orb-dot" style="background:rgba(201,168,76,0.9);box-shadow:0 0 8px rgba(201,168,76,0.7)"></div>
      </div>

      <!-- 魔法陣線 -->
      <div class="mc-line h"></div>
      <div class="mc-line v"></div>
      <div class="mc-line d1"></div>
      <div class="mc-line d2"></div>

      <!-- 中心: 箒シルエット -->
      <div class="ml-center">
        <svg viewBox="0 0 24 50" width="20" fill="none">
          <line x1="18" y1="3" x2="6" y2="38" stroke="rgba(201,168,76,0.6)" stroke-width="2" stroke-linecap="round"/>
          <line x1="2" y1="36" x2="7" y2="46" stroke="rgba(201,168,76,0.5)" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="5" y1="37" x2="10" y2="48" stroke="rgba(201,168,76,0.5)" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="8" y1="38" x2="13" y2="48" stroke="rgba(201,168,76,0.5)" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="11" y1="37" x2="15" y2="47" stroke="rgba(201,168,76,0.5)" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <span class="ml-star">✦</span>
      </div>
    </div>

    <!-- テキスト -->
    <div class="loading-text-area">
      <p class="loading-title">星を読んでいます</p>
      <p id="loading-text" class="loading-sub">太陽の位置を確認しています</p>
    </div>

    <!-- ドットインジケーター -->
    <div class="loading-dots">
      <div class="dot" style="animation-delay:0s"></div>
      <div class="dot" style="animation-delay:0.4s"></div>
      <div class="dot" style="animation-delay:0.8s"></div>
    </div>
  </div>


</main>
</Layout>

<script>
  const messages = [
    "太陽の位置を確認しています",
    "月の軌道を辿っています",
    "星の言葉に耳を澄ませています",
    "あなたの星座を読んでいます",
    "運命の糸を手繰り寄せています",
  ];

  const textEl = document.getElementById("loading-text")!;
  let idx = 0;

  const interval = setInterval(() => {
    idx = (idx + 1) % messages.length;
    textEl.style.opacity = "0";
    setTimeout(() => {
      textEl.textContent = messages[idx];
      textEl.style.opacity = "1";
    }, 350);
  }, 1100);

  setTimeout(() => {
    clearInterval(interval);
    window.location.href = import.meta.env.BASE_URL + "/result" + window.location.search;
  }, 3200);
</script>

<style>
.fp-loading-main {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.bg-space {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 30% 20% at 72% 14%, rgba(175,50,150,0.11) 0%, transparent 100%),
    radial-gradient(ellipse 55% 65% at 38% 60%, rgba(85,58,22,0.09) 0%, transparent 100%),
    radial-gradient(ellipse 130% 100% at 50% 45%, rgba(16,32,82,0.55) 0%, rgba(3,7,20,0.92) 60%, #010509 100%),
    radial-gradient(ellipse 80% 25% at 50% 108%, rgba(28,58,138,0.28) 0%, transparent 100%),
    #010509;
  z-index: 0;
}

.layer-stars, .layer-bokeh {
  position: absolute; inset: 0;
  pointer-events: none;
}
.layer-stars { z-index: 1; }
.layer-bokeh { z-index: 2; }

.star-micro {
  position: absolute; border-radius: 50%;
  animation: twinkle-slow ease-in-out infinite;
}
.star-small {
  position: absolute; border-radius: 50%;
  animation: twinkle ease-in-out infinite;
}
.star-bright {
  position: absolute; border-radius: 50%;
  background: #ffffff;
  box-shadow:
    0 0 2px 1px rgba(255,255,255,0.95),
    0 0 6px 2px rgba(200,220,255,0.6),
    0 0 14px 5px rgba(160,190,255,0.25),
    0 0 28px 8px rgba(120,160,255,0.1);
  animation: twinkle-bright ease-in-out infinite;
}
.star-spike {
  position: absolute;
  width: 4px; height: 4px; margin: -2px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow:
    0 0 3px 2px rgba(255,255,255,1),
    0 0 8px 4px rgba(200,225,255,0.7),
    0 0 20px 8px rgba(160,195,255,0.35),
    0 0 40px 14px rgba(120,165,255,0.12);
  animation: spike-pulse 3s ease-in-out infinite;
}
.star-spike::before {
  content: '';
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  width: 55px; height: 1px;
  background: linear-gradient(to right, transparent, rgba(200,225,255,0.35) 30%, rgba(255,255,255,0.7) 50%, rgba(200,225,255,0.35) 70%, transparent);
}
.star-spike::after {
  content: '';
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%) rotate(90deg);
  width: 55px; height: 1px;
  background: linear-gradient(to right, transparent, rgba(200,225,255,0.35) 30%, rgba(255,255,255,0.7) 50%, rgba(200,225,255,0.35) 70%, transparent);
}

@keyframes twinkle-slow { 0%,100%{opacity:inherit;transform:scale(1)} 50%{opacity:0.05;transform:scale(0.5)} }
@keyframes twinkle      { 0%,100%{opacity:inherit;transform:scale(1)} 50%{opacity:0.1;transform:scale(0.6)} }
@keyframes twinkle-bright { 0%,100%{opacity:inherit;transform:scale(1)} 40%{opacity:0.2;transform:scale(0.7)} 60%{opacity:0.2;transform:scale(0.7)} }
@keyframes spike-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.55;transform:scale(0.85)} }

.bokeh {
  position: absolute; border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, rgba(240,210,60,1) 0%, rgba(201,168,76,0.35) 45%, transparent 70%);
  filter: blur(10px);
  animation: bk-float 4.5s ease-in-out infinite;
}
@keyframes bk-float {
  0%,100% { transform: translateY(0) scale(1); }
  50%      { transform: translateY(-8px) scale(1.06); }
}

/* ローディングコンテンツ */
.loading-content {
  position: relative; z-index: 10;
  display: flex; flex-direction: column;
  align-items: center; gap: 2rem;
}

/* 魔法陣ローディングリング */
.magic-loader {
  position: relative;
  width: 160px; height: 160px;
  display: flex; align-items: center; justify-content: center;
}

.ml-ring {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  border: 1px solid;
  animation: ring-spin linear infinite;
}
.ml-dot {
  position: absolute; top: 50%; left: 50%;
  width: 4px; height: 4px; margin: -2px;
  border-radius: 50%;
  background: rgba(201,168,76,0.45);
}
.ml-orb-dot {
  position: absolute;
  top: -4px; left: calc(50% - 4px);
  width: 7px; height: 7px;
  border-radius: 50%;
}
@keyframes ring-spin {
  from { transform: translate(-50%,-50%) rotate(0deg); }
  to   { transform: translate(-50%,-50%) rotate(360deg); }
}

/* 魔法陣線 */
.mc-line {
  position: absolute; top: 50%; left: 50%;
  background: rgba(201,168,76,0.05);
}
.mc-line.h { width: 160px; height: 1px; transform: translate(-50%,-50%); }
.mc-line.v { width: 1px; height: 160px; transform: translate(-50%,-50%); }
.mc-line.d1 { width: 160px; height: 1px; transform: translate(-50%,-50%) rotate(45deg); }
.mc-line.d2 { width: 160px; height: 1px; transform: translate(-50%,-50%) rotate(-45deg); }

/* 中心 */
.ml-center {
  position: absolute;
  display: flex; flex-direction: column;
  align-items: center; gap: 2px;
}
.ml-star {
  font-size: 1.4rem;
  color: rgba(201,168,76,0.6);
  text-shadow: 0 0 12px rgba(201,168,76,0.5);
  animation: star-pulse 2.5s ease-in-out infinite;
}
@keyframes star-pulse {
  0%,100% { opacity: 0.6; transform: scale(1); }
  50%      { opacity: 1; transform: scale(1.12); }
}

/* テキスト */
.loading-text-area { text-align: center; space-y: 0.75rem; }
.loading-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 1.1rem; font-weight: 300;
  color: rgba(232,224,208,0.9);
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}
.loading-sub {
  font-size: 0.75rem;
  color: rgba(232,224,208,0.35);
  transition: opacity 0.35s;
  letter-spacing: 0.05em;
}

/* ドット */
.loading-dots { display: flex; gap: 8px; }
.dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: rgba(139,167,217,0.6);
  animation: dot-pulse 1.5s ease-in-out infinite;
}
@keyframes dot-pulse {
  0%,100% { opacity: 0.2; transform: scale(0.8); }
  50%      { opacity: 1; transform: scale(1); }
}

/* ブレイジングスター */
.layer-shooting {
  position: absolute; inset: 0;
  pointer-events: none;
  z-index: 3;
  overflow: hidden;
}
.blazing-star {
  position: absolute;
  left: 0;
  width: 280px; height: 40px;
  animation: blazing-fly 12s linear infinite;
  animation-delay: 0.5s;
  animation-fill-mode: backwards;
}
.blazing-head {
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 56px; height: 18px;
  border-radius: 50%;
  background: radial-gradient(ellipse at 25% 50%,
    #ffffff 0%, #b0ffff 25%, #00ddee 55%, transparent 100%);
  filter: blur(2px);
  box-shadow:
    0 0 8px 4px rgba(0, 220, 255, 0.9),
    0 0 20px 10px rgba(0, 180, 220, 0.5),
    0 0 40px 20px rgba(0, 140, 200, 0.2);
}
.trail-orb {
  position: absolute;
  border-radius: 50%;
  background: #ffffff;
  transform: translateY(-50%);
}
.trail-orb.large {
  width: 11px; height: 11px;
  box-shadow:
    0 0 4px 2px rgba(160, 232, 255, 0.9),
    0 0 12px 5px rgba(0, 180, 255, 0.4);
}
.trail-orb.mid {
  width: 7px; height: 7px;
  box-shadow:
    0 0 3px 1px rgba(160, 232, 255, 0.8),
    0 0 8px 3px rgba(0, 180, 255, 0.3);
}
.trail-orb.small {
  width: 4px; height: 4px;
  box-shadow:
    0 0 2px 1px rgba(160, 232, 255, 0.6);
}
@keyframes blazing-fly {
  0%   { transform: translateX(calc(100vw + 300px)); opacity: 0; }
  5%   { opacity: 1; }
  90%  { opacity: 0.85; }
  100% { transform: translateX(-300px); opacity: 0; }
}
</style>
