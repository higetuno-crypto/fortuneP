---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

function rnd(a: number, b: number) { return a + Math.random() * (b - a); }
const stars = Array.from({ length: 80 }, () => ({
  x: rnd(0,100), y: rnd(0,100),
  s: Math.random() < 0.8 ? 1 : 1.5,
  op: rnd(0.2, 0.75), dur: rnd(2,5), del: rnd(0,4),
}));
---

<Layout title="生年月日を入力">
  <main class="relative flex min-h-screen flex-col overflow-hidden select-none" style="background:radial-gradient(ellipse at 50% 0%, #12082e 0%, #06081a 40%, #050712 100%)">

    <!-- 星空 -->
    <div class="pointer-events-none absolute inset-0 z-0">
      {stars.map(s => (
        <div style={`position:absolute;left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;border-radius:50%;background:white;opacity:${s.op};animation:twinkle-inp ${s.dur}s ${s.del}s ease-in-out infinite`}></div>
      ))}
    </div>

    <!-- ボケ玉 -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden z-0">
      <div class="bokeh" style="width:70px;height:70px;top:0%;left:5%"></div>
      <div class="bokeh" style="width:45px;height:45px;top:2%;left:55%;animation-delay:1.2s"></div>
      <div class="bokeh" style="width:60px;height:60px;top:1%;right:8%;animation-delay:0.7s"></div>
      <div class="bokeh" style="width:30px;height:30px;top:6%;left:30%;animation-delay:2s"></div>
    </div>

    <!-- ヘッダー -->
    <div class="relative z-10 flex items-center justify-between px-6 pt-8 pb-0">
      <button id="btn-back" class="text-fp-pearl/30 text-sm transition-colors hover:text-fp-pearl/60 hidden">
        ← 戻る
      </button>
      <a href={import.meta.env.BASE_URL} class="font-cinzel text-sm text-fp-gold/50 hover:text-fp-gold/80 transition-colors ml-auto">
        fortuneP
      </a>
    </div>

    <!-- 進捗ドット -->
    <div class="relative z-10 flex justify-center gap-2 mt-6">
      <div class="prog-dot active" id="dot-1"></div>
      <div class="prog-dot" id="dot-2"></div>
      <div class="prog-dot" id="dot-3"></div>
      <div class="prog-dot" id="dot-4"></div>
    </div>

    <!-- ======== ステップコンテナ ======== -->
    <div class="relative z-10 flex-1 flex flex-col">

      <!-- Step 1: 年 -->
      <div id="step-1" class="wizard-step active flex-1 flex flex-col items-center justify-center px-8 gap-10">
        <div class="text-center space-y-2">
          <p class="step-label">生まれた年は？</p>
          <p class="step-hint">西暦で入力してください</p>
        </div>
        <input
          id="year-input"
          type="number"
          inputmode="numeric"
          placeholder="例：1995"
          min="1900"
          max="2026"
          class="year-input"
          autocomplete="off"
        />
        <p id="year-error" class="text-fp-glow/60 text-sm hidden">正しい年を入力してください</p>
        <button class="step-next-btn" onclick="goStep1()">次へ</button>
      </div>

      <!-- Step 2: 月 -->
      <div id="step-2" class="wizard-step flex-1 flex flex-col items-center justify-center px-6 gap-8">
        <div class="text-center space-y-2">
          <p class="step-label">生まれた月は？</p>
        </div>
        <div class="month-grid">
          {Array.from({length: 12}, (_, i) => i + 1).map(m => (
            <button class="month-btn" data-month={m} onclick={`selectMonth(${m})`}>
              {m}月
            </button>
          ))}
        </div>
      </div>

      <!-- Step 3: 日 -->
      <div id="step-3" class="wizard-step flex-1 flex flex-col items-center justify-center px-8 gap-10">
        <div class="text-center space-y-2">
          <p class="step-label">生まれた日は？</p>
          <p id="step3-sub" class="text-fp-gold/50 text-sm"></p>
        </div>
        <input
          id="day-input"
          type="number"
          inputmode="numeric"
          placeholder="例：15"
          min="1"
          max="31"
          class="year-input"
          autocomplete="off"
        />
        <p id="day-error" class="text-fp-glow/60 text-sm hidden">正しい日を入力してください</p>
        <button class="step-next-btn" onclick="goStep3()">次へ</button>
      </div>

      <!-- Step 4: 時間（任意） -->
      <div id="step-4" class="wizard-step flex-1 flex flex-col items-center justify-center px-8 gap-8">
        <div class="text-center space-y-2">
          <p class="step-label">生まれた時間は？</p>
          <p class="step-hint">わかると、アセンダントも読めます</p>
        </div>

        <div class="flex gap-4 items-center">
          <select id="hour-sel" class="time-sel">
            <option value="">--</option>
            {Array.from({length: 24}, (_, i) => i).map(h => (
              <option value={h}>{h}時</option>
            ))}
          </select>
          <span class="text-fp-pearl/30 text-lg">:</span>
          <select id="min-sel" class="time-sel">
            <option value="">--</option>
            {[0,5,10,15,20,25,30,35,40,45,50,55].map(m => (
              <option value={m}>{String(m).padStart(2,'0')}分</option>
            ))}
          </select>
        </div>

        <!-- 軌道「星を読む」ボタン -->
        <div class="orbital-sm" onclick="submitForm()">
          <div class="orb-ring-sm" style="width:110px;height:110px;animation-duration:6s">
            <div class="orb-dot-sm"></div>
          </div>
          <div class="orb-ring-sm" style="width:136px;height:136px;animation-duration:10s;animation-direction:reverse;opacity:0.55">
            <div class="orb-dot-sm" style="width:4px;height:4px;top:-2px;left:calc(50% - 2px)"></div>
          </div>
          <div class="orb-center-sm">
            <span class="font-sans text-xs font-medium text-fp-dark">星を読む</span>
          </div>
        </div>

        <button class="text-fp-pearl/30 text-xs underline underline-offset-4 hover:text-fp-pearl/60 transition-colors" onclick="skipTime()">
          時間はわからない
        </button>
      </div>

    </div><!-- /ステップコンテナ -->
  </main>
</Layout>

<style>
  .font-cinzel { font-family: 'Cinzel', serif; }

  /* ボケ玉 */
  .bokeh-orb {
    position: absolute; border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, rgba(230,190,60,1) 0%, rgba(201,168,76,0.4) 40%, transparent 70%);
    filter: blur(10px);
    animation: bokeh-float 4s ease-in-out infinite;
  }
  .sparkle { position: absolute; font-size: 10px; color: rgba(255,255,255,0.7); animation: sparkle-blink 2.5s ease-in-out infinite; }
  @keyframes bokeh-float { 0%,100%{transform:translateY(0) scale(1)} 50%{transform:translateY(-6px) scale(1.05)} }
  @keyframes twinkle-inp { 0%,100%{opacity:var(--op,0.5);transform:scale(1)} 50%{opacity:calc(var(--op,0.5)*0.15);transform:scale(0.5)} }
  .bokeh {
    position: absolute; border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, rgba(240,210,60,1) 0%, rgba(201,168,76,0.35) 45%, transparent 70%);
    filter: blur(10px);
    animation: bokeh-float 4.5s ease-in-out infinite;
  }
  @keyframes sparkle-blink { 0%,100%{opacity:0.8;transform:scale(1)} 50%{opacity:0.2;transform:scale(0.7)} }

  /* 進捗ドット */
  .prog-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(201,168,76,0.2);
    transition: all 0.4s ease;
  }
  .prog-dot.active {
    width: 20px; border-radius: 3px;
    background: rgba(201,168,76,0.8);
    box-shadow: 0 0 8px rgba(201,168,76,0.4);
  }

  /* ウィザードステップ */
  .wizard-step {
    display: none;
    animation: step-in 0.35s ease both;
  }
  .wizard-step.active { display: flex; }
  @keyframes step-in {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* テキスト */
  .step-label {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.25rem;
    font-weight: 300;
    color: rgba(232,224,208,0.95);
    letter-spacing: 0.05em;
  }
  .step-hint { font-size: 0.75rem; color: rgba(232,224,208,0.35); }

  /* 年入力 */
  .year-input {
    width: 100%; max-width: 260px;
    text-align: center;
    font-size: 2.5rem;
    font-family: 'Cinzel', serif;
    color: rgba(201,168,76,0.9);
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(201,168,76,0.3);
    padding: 8px 0;
    outline: none;
    caret-color: rgba(201,168,76,0.8);
  }
  .year-input::placeholder { color: rgba(201,168,76,0.2); font-size: 1.5rem; }
  .year-input:focus { border-bottom-color: rgba(201,168,76,0.7); }

  /* 次へボタン */
  .step-next-btn {
    min-width: 140px; min-height: 48px;
    border-radius: 9999px;
    border: 1px solid rgba(201,168,76,0.5);
    background: rgba(201,168,76,0.08);
    color: rgba(201,168,76,0.9);
    font-size: 0.875rem;
    letter-spacing: 0.15em;
    transition: all 0.2s;
  }
  .step-next-btn:active { transform: scale(0.95); background: rgba(201,168,76,0.18); }

  /* 月グリッド */
  .month-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    width: 100%; max-width: 320px;
  }
  .month-btn {
    height: 52px; border-radius: 12px;
    border: 1px solid rgba(201,168,76,0.2);
    background: rgba(255,255,255,0.04);
    color: rgba(232,224,208,0.7);
    font-size: 0.875rem;
    transition: all 0.15s;
  }
  .month-btn:active, .month-btn.selected {
    background: rgba(201,168,76,0.18);
    border-color: rgba(201,168,76,0.6);
    color: rgba(201,168,76,1);
    box-shadow: 0 0 12px rgba(201,168,76,0.2);
  }

  /* 時間セレクト */
  .time-sel {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(201,168,76,0.25);
    border-radius: 12px;
    color: rgba(232,224,208,0.8);
    font-size: 1.1rem;
    padding: 12px 16px;
    outline: none;
    min-width: 100px;
    text-align: center;
    appearance: none;
    -webkit-appearance: none;
  }
  .time-sel:focus { border-color: rgba(201,168,76,0.6); }

  /* 小さい軌道ボタン */
  .orbital-sm {
    position: relative;
    width: 136px; height: 136px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .orb-ring-sm {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    border-radius: 50%;
    border: 1px solid rgba(201,168,76,0.25);
    animation: ring-spin linear infinite;
  }
  .orb-dot-sm {
    position: absolute;
    width: 6px; height: 6px; top: -3px; left: calc(50% - 3px);
    border-radius: 50%;
    background: rgba(201,168,76,0.9);
    box-shadow: 0 0 6px rgba(201,168,76,0.5);
  }
  .orb-center-sm {
    position: absolute;
    width: 76px; height: 76px; border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #f5de7a, #c9a84c 55%, #a07830 100%);
    box-shadow: 0 0 24px rgba(201,168,76,0.4), 0 0 48px rgba(201,168,76,0.15);
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .orbital-sm:active .orb-center-sm { transform: scale(0.93); }

  @keyframes ring-spin {
    from { transform: translate(-50%,-50%) rotate(0deg); }
    to   { transform: translate(-50%,-50%) rotate(360deg); }
  }
</style>

<script define:vars={{ base: import.meta.env.BASE_URL }}>
  // 状態
  const state = { year: null, month: null, day: null, hour: '', minute: '' };
  let currentStep = 1;

  function setStep(n) {
    document.querySelectorAll('.wizard-step').forEach(el => el.classList.remove('active'));
    document.getElementById(`step-${n}`).classList.add('active');
    // 進捗ドット
    for (let i = 1; i <= 4; i++) {
      const dot = document.getElementById(`dot-${i}`);
      dot.classList.toggle('active', i === n);
    }
    // 戻るボタン
    const backBtn = document.getElementById('btn-back');
    backBtn.classList.toggle('hidden', n === 1);
    currentStep = n;
  }

  // 戻る
  document.getElementById('btn-back').addEventListener('click', () => {
    if (currentStep > 1) setStep(currentStep - 1);
  });

  // Step1: 年
  window.goStep1 = function() {
    const val = parseInt(document.getElementById('year-input').value);
    const err = document.getElementById('year-error');
    if (!val || val < 1900 || val > 2026) {
      err.classList.remove('hidden');
      return;
    }
    err.classList.add('hidden');
    state.year = val;
    setStep(2);
  };

  // Step1 Enter キー
  document.getElementById('year-input').addEventListener('keydown', e => {
    if (e.key === 'Enter') window.goStep1();
  });

  // Step2: 月
  window.selectMonth = function(m) {
    state.month = m;
    document.querySelectorAll('.month-btn').forEach(b => b.classList.remove('selected'));
    document.querySelector(`[data-month="${m}"]`).classList.add('selected');
    // 少し待ってから次へ（選択の視覚的フィードバック）
    setTimeout(() => {
      document.getElementById('step3-sub').textContent = `${state.year}年 ${state.month}月`;
      setStep(3);
    }, 180);
  };

  // Step3: 日
  window.goStep3 = function() {
    const val = parseInt(document.getElementById('day-input').value);
    const err = document.getElementById('day-error');
    if (!val || val < 1 || val > 31) {
      err.classList.remove('hidden');
      return;
    }
    err.classList.add('hidden');
    state.day = val;
    setStep(4);
  };

  document.getElementById('day-input').addEventListener('keydown', e => {
    if (e.key === 'Enter') window.goStep3();
  });

  // Step4: 提出
  window.submitForm = function() {
    const hour = document.getElementById('hour-sel').value;
    const min  = document.getElementById('min-sel').value;
    state.hour   = hour;
    state.minute = min;
    navigate();
  };

  window.skipTime = function() {
    state.hour   = '';
    state.minute = '';
    navigate();
  };

  function navigate() {
    const p = new URLSearchParams();
    p.set('year',  state.year);
    p.set('month', state.month);
    p.set('day',   state.day);
    if (state.hour !== '') p.set('hour',   state.hour);
    if (state.minute !== '') p.set('minute', state.minute);
    window.location.href = base + 'loading?' + p.toString();
  }
</script>
