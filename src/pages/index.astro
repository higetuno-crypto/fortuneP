---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

// ビルド時に星を生成（静的HTML = 高速）
function rnd(a: number, b: number) { return a + Math.random() * (b - a); }

const tinyStars = Array.from({ length: 140 }, (_, i) => ({
  x: rnd(0, 100), y: rnd(0, 100),
  s: Math.random() < 0.75 ? 1 : 1.5,
  op: rnd(0.25, 0.85),
  dur: rnd(2.5, 6),
  del: rnd(0, 5),
}));

const glowStars = Array.from({ length: 18 }, () => ({
  x: rnd(0, 100), y: rnd(5, 95),
  s: rnd(2, 3.5),
  op: rnd(0.5, 1),
  dur: rnd(1.5, 4),
  del: rnd(0, 4),
}));
---

<Layout title="fortuneP">
<main class="fp-main">

  <!-- ========== 背景: 深宇宙グラデーション ========== -->
  <div class="bg-space"></div>

  <!-- ========== 星空レイヤー ========== -->
  <div class="layer-stars" aria-hidden="true">
    {tinyStars.map(s => (
      <div class="star-tiny"
        style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;opacity:${s.op};animation-duration:${s.dur}s;animation-delay:${s.del}s`}></div>
    ))}
    {glowStars.map(s => (
      <div class="star-glow"
        style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;opacity:${s.op};animation-duration:${s.dur}s;animation-delay:${s.del}s`}></div>
    ))}
  </div>

  <!-- ========== 金のボケ玉（魔理沙の魔力の光） ========== -->
  <div class="layer-bokeh" aria-hidden="true">
    <div class="bokeh" style="width:80px;height:80px;top:1%;left:7%;animation-delay:0s"></div>
    <div class="bokeh" style="width:50px;height:50px;top:3%;left:30%;animation-delay:1.1s"></div>
    <div class="bokeh" style="width:70px;height:70px;top:0%;left:55%;animation-delay:0.6s"></div>
    <div class="bokeh" style="width:40px;height:40px;top:4%;right:22%;animation-delay:1.8s"></div>
    <div class="bokeh" style="width:90px;height:90px;top:1%;right:5%;animation-delay:0.3s"></div>
    <div class="bokeh" style="width:30px;height:30px;top:7%;left:44%;animation-delay:2.3s"></div>
  </div>

  <!-- ========== 魔理沙モチーフ: 魔女帽子 ========== -->
  <div class="layer-motifs" aria-hidden="true">
    <!-- 左奥の魔女帽子 -->
    <div class="motif" style="left:2%;top:28%;transform:rotate(-18deg) scale(0.55);opacity:0.13">
      <svg viewBox="0 0 60 70" width="60" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M30 5 L7 55 L53 55 Z" stroke="#c9a84c" stroke-width="1.5" stroke-linejoin="round"/>
        <ellipse cx="30" cy="57" rx="25" ry="7.5" stroke="#c9a84c" stroke-width="1.5"/>
        <path d="M13 51 Q30 44 47 51" stroke="#c9a84c" stroke-width="2" stroke-linecap="round"/>
        <path d="M21 48 Q26 43 30 48 Q34 43 39 48" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <text x="25" y="28" font-size="10" fill="#c9a84c">★</text>
      </svg>
    </div>
    <!-- 右上の魔女帽子 -->
    <div class="motif" style="right:3%;top:12%;transform:rotate(15deg) scale(0.65);opacity:0.11">
      <svg viewBox="0 0 60 70" width="60" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M30 5 L7 55 L53 55 Z" stroke="#c9a84c" stroke-width="1.5" stroke-linejoin="round"/>
        <ellipse cx="30" cy="57" rx="25" ry="7.5" stroke="#c9a84c" stroke-width="1.5"/>
        <path d="M13 51 Q30 44 47 51" stroke="#c9a84c" stroke-width="2" stroke-linecap="round"/>
        <path d="M21 48 Q26 43 30 48 Q34 43 39 48" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <text x="25" y="28" font-size="10" fill="#c9a84c">★</text>
      </svg>
    </div>
    <!-- 右下の大きめ帽子 -->
    <div class="motif" style="right:1%;bottom:18%;transform:rotate(8deg) scale(0.9);opacity:0.08">
      <svg viewBox="0 0 60 70" width="60" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M30 5 L7 55 L53 55 Z" stroke="#c9a84c" stroke-width="1.5" stroke-linejoin="round"/>
        <ellipse cx="30" cy="57" rx="25" ry="7.5" stroke="#c9a84c" stroke-width="1.5"/>
        <path d="M13 51 Q30 44 47 51" stroke="#c9a84c" stroke-width="2" stroke-linecap="round"/>
        <path d="M21 48 Q26 43 30 48 Q34 43 39 48" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <text x="25" y="28" font-size="10" fill="#c9a84c">★</text>
      </svg>
    </div>

    <!-- 箒 (左下) -->
    <div class="motif" style="left:3%;bottom:20%;transform:rotate(40deg) scale(0.7);opacity:0.12">
      <svg viewBox="0 0 40 110" width="40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="32" y1="4" x2="9" y2="85" stroke="#c9a84c" stroke-width="2.5" stroke-linecap="round"/>
        <ellipse cx="11" cy="81" rx="6" ry="3" transform="rotate(-70 11 81)" stroke="#c9a84c" stroke-width="1.5"/>
        <line x1="1" y1="78" x2="10" y2="96" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="5" y1="81" x2="13" y2="100" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="10" y1="83" x2="17" y2="102" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="14" y1="83" x2="20" y2="100" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="18" y1="81" x2="23" y2="97" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>
    <!-- 箒 (右中) -->
    <div class="motif" style="right:4%;top:45%;transform:rotate(-50deg) scale(0.6);opacity:0.1">
      <svg viewBox="0 0 40 110" width="40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="32" y1="4" x2="9" y2="85" stroke="#c9a84c" stroke-width="2.5" stroke-linecap="round"/>
        <ellipse cx="11" cy="81" rx="6" ry="3" transform="rotate(-70 11 81)" stroke="#c9a84c" stroke-width="1.5"/>
        <line x1="1" y1="78" x2="10" y2="96" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="5" y1="81" x2="13" y2="100" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="10" y1="83" x2="17" y2="102" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="14" y1="83" x2="20" y2="100" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="18" y1="81" x2="23" y2="97" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>
  </div>

  <!-- ========== 流れ星: 魔理沙が箒で夜空を駆ける ========== -->
  <div class="layer-shooting" aria-hidden="true">
    <div class="marisa-fly">
      <svg viewBox="0 0 90 36" width="90" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- 光の尾 -->
        <path d="M90 18 Q60 14 0 18" stroke="url(#tail)" stroke-width="2" stroke-linecap="round"/>
        <defs>
          <linearGradient id="tail" x1="90" y1="0" x2="0" y2="0">
            <stop offset="0%" stop-color="rgba(201,168,76,0.9)"/>
            <stop offset="100%" stop-color="transparent"/>
          </linearGradient>
        </defs>
        <!-- 箒ハンドル -->
        <line x1="78" y1="8" x2="58" y2="26" stroke="#c9a84c" stroke-width="2" stroke-linecap="round"/>
        <!-- 穂先 -->
        <line x1="53" y1="24" x2="58" y2="32" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="56" y1="25" x2="60" y2="33" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="59" y1="26" x2="62" y2="33" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="61" y1="25" x2="64" y2="31" stroke="#c9a84c" stroke-width="1.5" stroke-linecap="round"/>
        <!-- 帽子シルエット -->
        <path d="M76 6 L68 14 L84 14 Z" fill="#c9a84c" opacity="0.8"/>
        <ellipse cx="76" cy="14.5" rx="9" ry="2.5" fill="#c9a84c" opacity="0.8"/>
        <!-- 星屑 -->
        <text x="40" y="14" font-size="8" fill="#f0d870" opacity="0.8">★</text>
        <text x="22" y="20" font-size="6" fill="#f0d870" opacity="0.5">✦</text>
        <text x="8"  y="16" font-size="5" fill="#f0d870" opacity="0.3">★</text>
      </svg>
    </div>
    <!-- 2回目は別タイミングで -->
    <div class="marisa-fly" style="animation-delay:14s;top:62%;transform:scaleY(-1) rotate(3deg)"></div>
  </div>

  <!-- ========== メインコンテンツ ========== -->

  <!-- ヘッダー -->
  <header class="fp-header">
    <h1 class="fp-title">fortuneP</h1>
    <div class="fp-subtitle">
      <span class="line"></span>
      <span class="sub-text">✦ Astrology Reading ✦</span>
      <span class="line"></span>
    </div>
  </header>

  <!-- 魔法陣ホイール (魔理沙の魔法陣 × 黄道12宮) -->
  <div class="magic-circle" aria-hidden="true">
    <!-- 外周リング -->
    <div class="mc-ring outer"></div>
    <!-- 内周リング -->
    <div class="mc-ring inner"></div>
    <!-- 12星座の点 + 4つの強調星 -->
    {Array.from({ length: 12 }, (_, i) => (
      <div
        class={`mc-dot ${[0,3,6,9].includes(i) ? 'mc-dot-star' : ''}`}
        style={`transform:rotate(${i * 30}deg) translateY(-100px) rotate(-${i * 30}deg)`}
      >
        {[0,3,6,9].includes(i) ? '✦' : ''}
      </div>
    ))}
    <!-- ハッチラインで魔法陣っぽく -->
    <div class="mc-cross h"></div>
    <div class="mc-cross v"></div>
    <div class="mc-cross d1"></div>
    <div class="mc-cross d2"></div>

    <!-- 中心: 箒と星 -->
    <div class="mc-center">
      <div class="mc-star-glow">✦</div>
      <!-- 中心の小さな箒シルエット -->
      <svg class="mc-broom" viewBox="0 0 24 50" width="24" fill="none">
        <line x1="18" y1="3" x2="6" y2="38" stroke="rgba(201,168,76,0.5)" stroke-width="2" stroke-linecap="round"/>
        <line x1="2" y1="36" x2="7" y2="46" stroke="rgba(201,168,76,0.4)" stroke-width="1.2" stroke-linecap="round"/>
        <line x1="5" y1="37" x2="10" y2="48" stroke="rgba(201,168,76,0.4)" stroke-width="1.2" stroke-linecap="round"/>
        <line x1="8" y1="38" x2="13" y2="48" stroke="rgba(201,168,76,0.4)" stroke-width="1.2" stroke-linecap="round"/>
        <line x1="11" y1="37" x2="15" y2="47" stroke="rgba(201,168,76,0.4)" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
    </div>
  </div>

  <!-- コピー -->
  <div class="fp-copy">
    <p class="fp-copy-main">表の自分と、心の奥を<br />星から読む。</p>
    <p class="fp-copy-sub">太陽 · 月 · アセンダント</p>
  </div>

  <!-- 軌道ボタン -->
  <div class="fp-cta">
    <a href={`${import.meta.env.BASE_URL}input`} class="orbital-btn" aria-label="星を読む">
      <div class="orb-ring" style="width:132px;height:132px;animation-duration:6s">
        <div class="orb-dot" style="width:7px;height:7px"></div>
      </div>
      <div class="orb-ring" style="width:162px;height:162px;animation-duration:9s;animation-direction:reverse">
        <div class="orb-dot" style="width:5px;height:5px;top:-2.5px"></div>
        <div class="orb-dot star-dot">★</div>
      </div>
      <div class="orb-ring" style="width:196px;height:196px;animation-duration:14s;opacity:0.45">
        <div class="orb-dot" style="width:4px;height:4px;opacity:0.5"></div>
      </div>
      <div class="orb-center">
        <span>星を読む</span>
      </div>
    </a>
    <p class="fp-tap-hint">TAP TO BEGIN</p>
  </div>

</main>
</Layout>

<style>
/* ======== レイアウト ======== */
.fp-main {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 2.5rem 1.5rem 2rem;
  overflow: hidden;
  user-select: none;
}

/* ======== 背景 ======== */
.bg-space {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at 50% 0%, #12082e 0%, #06081a 40%, #050712 100%);
  z-index: 0;
}

/* ======== 星空 ======== */
.layer-stars, .layer-bokeh, .layer-motifs, .layer-shooting {
  position: absolute; inset: 0;
  pointer-events: none;
}
.layer-stars { z-index: 1; }
.layer-bokeh { z-index: 2; }
.layer-motifs { z-index: 3; }
.layer-shooting { z-index: 4; }

.star-tiny {
  position: absolute;
  border-radius: 50%;
  background: white;
  animation: twinkle ease-in-out infinite;
}
.star-glow {
  position: absolute;
  border-radius: 50%;
  background: white;
  box-shadow: 0 0 4px 1px rgba(255,255,255,0.5);
  animation: twinkle ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: var(--op, 0.6); transform: scale(1); }
  50%       { opacity: calc(var(--op, 0.6) * 0.2); transform: scale(0.6); }
}

/* ======== ボケ玉 ======== */
.bokeh {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, rgba(240,210,60,1) 0%, rgba(201,168,76,0.35) 45%, transparent 70%);
  filter: blur(10px);
  animation: bk-float 4.5s ease-in-out infinite;
}
@keyframes bk-float {
  0%,100% { transform: translateY(0) scale(1); }
  50%      { transform: translateY(-8px) scale(1.06); }
}

/* ======== モチーフ ======== */
.motif { position: absolute; }

/* ======== 流れ星 (魔理沙の飛翔) ======== */
.marisa-fly {
  position: absolute;
  top: 28%;
  right: -100px;
  opacity: 0;
  animation: marisa-across 18s ease-in-out infinite;
}
@keyframes marisa-across {
  0%   { right: -100px; opacity: 0; }
  4%   { opacity: 0.55; }
  90%  { opacity: 0.45; }
  100% { right: 110%; opacity: 0; }
}

/* ======== ヘッダー ======== */
.fp-header {
  position: relative; z-index: 10;
  text-align: center;
}
.fp-title {
  font-family: 'Cinzel', serif;
  font-size: 2.6rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: #c9a84c;
  text-shadow: 0 0 30px rgba(201,168,76,0.55), 0 0 70px rgba(201,168,76,0.2);
}
.fp-subtitle {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  margin-top: 6px;
}
.fp-subtitle .line { flex: 1; max-width: 40px; height: 1px; background: rgba(201,168,76,0.35); }
.sub-text { font-size: 0.65rem; letter-spacing: 0.3em; color: rgba(201,168,76,0.55); }

/* ======== 魔法陣 ======== */
.magic-circle {
  position: relative; z-index: 10;
  width: 230px; height: 230px;
  display: flex; align-items: center; justify-content: center;
}
.mc-ring {
  position: absolute; top: 50%; left: 50%;
  border-radius: 50%;
  transform: translate(-50%,-50%);
}
.mc-ring.outer { width: 220px; height: 220px; border: 1px solid rgba(201,168,76,0.2); }
.mc-ring.inner { width: 175px; height: 175px; border: 1px solid rgba(201,168,76,0.12); }

.mc-dot {
  position: absolute; top: 50%; left: 50%;
  width: 5px; height: 5px;
  margin: -2.5px;
  border-radius: 50%;
  background: rgba(201,168,76,0.5);
}
.mc-dot-star {
  width: auto; height: auto;
  background: transparent;
  font-size: 10px; color: rgba(201,168,76,0.75);
  margin: -6px -4px;
  border-radius: 0;
  text-shadow: 0 0 8px rgba(201,168,76,0.6);
}

/* 魔法陣の十字線 */
.mc-cross {
  position: absolute; top: 50%; left: 50%;
  background: rgba(201,168,76,0.06);
}
.mc-cross.h { width: 220px; height: 1px; transform: translate(-50%,-50%); }
.mc-cross.v { width: 1px; height: 220px; transform: translate(-50%,-50%); }
.mc-cross.d1 { width: 220px; height: 1px; transform: translate(-50%,-50%) rotate(45deg); }
.mc-cross.d2 { width: 220px; height: 1px; transform: translate(-50%,-50%) rotate(-45deg); }

/* 中心部 */
.mc-center {
  position: absolute;
  display: flex; flex-direction: column; align-items: center; gap: 4px;
}
.mc-star-glow {
  font-size: 2.5rem;
  color: rgba(201,168,76,0.65);
  text-shadow: 0 0 20px rgba(201,168,76,0.5), 0 0 40px rgba(201,168,76,0.2);
  animation: star-pulse 3s ease-in-out infinite;
}
@keyframes star-pulse {
  0%,100% { opacity: 0.65; transform: scale(1); }
  50%      { opacity: 0.9; transform: scale(1.08); }
}
.mc-broom {
  opacity: 0.7;
  margin-top: -4px;
}

/* ======== コピー ======== */
.fp-copy { position: relative; z-index: 10; text-align: center; }
.fp-copy-main {
  font-family: 'Noto Serif JP', serif;
  font-size: 1rem; font-weight: 300;
  line-height: 1.9;
  color: rgba(232,224,208,0.88);
}
.fp-copy-sub { font-size: 0.7rem; color: rgba(232,224,208,0.3); margin-top: 6px; letter-spacing: 0.1em; }

/* ======== 軌道ボタン ======== */
.fp-cta { position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.fp-tap-hint { font-size: 0.6rem; letter-spacing: 0.4em; color: rgba(232,224,208,0.2); }

.orbital-btn {
  position: relative;
  width: 196px; height: 196px;
  display: flex; align-items: center; justify-content: center;
  text-decoration: none;
}
.orb-ring {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  border: 1px solid rgba(201,168,76,0.22);
  animation: ring-spin linear infinite;
}
.orb-dot {
  position: absolute;
  top: -3.5px; left: calc(50% - 3.5px);
  border-radius: 50%;
  background: rgba(201,168,76,0.95);
  box-shadow: 0 0 8px rgba(201,168,76,0.6);
}
.star-dot {
  width: auto; height: auto;
  border-radius: 0; background: transparent;
  top: auto; bottom: -6px; left: calc(50% - 5px);
  font-size: 9px; color: rgba(201,168,76,0.8);
  box-shadow: none;
}
.orb-center {
  position: absolute;
  width: 90px; height: 90px; border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, #f5de7a, #c9a84c 55%, #9c7428 100%);
  box-shadow: 0 0 32px rgba(201,168,76,0.55), 0 0 64px rgba(201,168,76,0.2);
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.orb-center span {
  font-family: system-ui, sans-serif;
  font-size: 0.8rem; font-weight: 600;
  color: #0a0e1a; letter-spacing: 0.05em;
}
.orbital-btn:active .orb-center {
  transform: scale(0.93);
  box-shadow: 0 0 16px rgba(201,168,76,0.4);
}
@keyframes ring-spin {
  from { transform: translate(-50%,-50%) rotate(0deg); }
  to   { transform: translate(-50%,-50%) rotate(360deg); }
}
</style>
